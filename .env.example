# --- PayPal (required for real sandbox checkout; omit to use simulated checkout) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# --- AI (optional; without it PriceScout uses deterministic rule-based fallback) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=            # any OpenAI-compatible endpoint
# --- App ---
APP_URL=http://localhost:3000  # used in alert "Buy with PayPal" links
DATA_DIR=./data                # SQLite file location
CRON_SECRET=                   # if set, /api/cron/check-prices requires "Authorization: Bearer <secret>"
# --- Web Push (always on; keys auto-generated into the DB if unset. `npm run vapid` writes them here) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# --- Email alerts (optional): Resend OR SMTP ---
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=PriceScout <onboarding@resend.dev>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# --- SMS alerts (optional): Twilio ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ALERT_SMS_TO=
